      "next": null,
      "nextExplicit": false,
      "textureNodeId": "f_msha5ev8_aluxu8",
      "textureFile": "25.png",
      "textNodeId": "f_msha5ev8_aluxu8",
      "speaker": "？？？",
      "text": "先生，我以为是接我的阿婆，吉时快到了，能帮我拿一下接亲的红伞吗？",
      "textPos": "bottom",
      "audioFile": null,
      "inEffect": "fade",
      "outEffect": "fade",
      "holdSec": -1,
      "autoSkip": null,
      "popup": null,
      "dialogueChain": [
        {
          "speaker": "？？？",
          "text": "沈家的规矩没有拜堂必须红伞罩头才可以从这房间出去"
        },
        {
          "speaker": "我",
          "text": "可以……"
        }
      ]
    }
