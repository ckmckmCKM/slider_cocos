      "textNodeId": "f_msha5ev8_ob2iog",
      "speaker": "？？？",
      "text": "谁？谁在外面？",
      "textPos": "bottom",
      "audioFile": null,
      "inEffect": "fade",
      "outEffect": "fade",
      "holdSec": -1,
      "autoSkip": null,
      "popup": null,
      "dialogueChain": [
        {
          "speaker": "我",
          "text": "啊，新娘子，我是主家请的摄影师，我叫林墨"
        }
      ]
    },
    {
      "id": "f_msha5ev8_aluxu8",
      "kind": "frame",
      "name": "25.png",
